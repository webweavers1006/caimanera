# Base de Datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/caimanera"

# JWT — Clave secreta para firmar tokens de sesión (mínimo 32 caracteres)
# Generar con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-una-clave-segura-de-al-menos-32-caracteres"

# Admin — Contraseña del usuario administrador inicial (solo para seed).
# Usa ADMIN_PASSWORD_HASH (hash bcrypt) en vez de texto plano.
# Genera el hash con: node prisma/seeds/generate-hashes.js
# ADMIN_DEFAULT_PASSWORD="admin123"       # ❌ No usar — texto plano en .env
ADMIN_PASSWORD_HASH="$2b$10$RuzwWf47R7CAksw5OgS3LOxqh.I/lRwSCAG04DuKovd2sh0VyqHPu"

# Entorno (development | production)
NODE_ENV="development"

# Cookie segura — por defecto true. Solo poner false en desarrollo local sin HTTPS.
COOKIE_SECURE="false"

# Bloqueo de DevTools y consola en producción (disable-devtool).
# Poner "true" en el .env de producción. No definir en desarrollo.
# NEXT_PUBLIC_DISABLE_DEVTOOLS="true"

# Módulo de Turnos — por defecto inactivo (aún no está en uso).
# Poner "true" para habilitar /turnos, /tomar-turno y el panel de turnos.
# NEXT_PUBLIC_TICKETS_ENABLED="false"

# Nivel de logging (error | warn | info | debug)
LOG_LEVEL="info"

# URL pública del sitio (HTTPS). Usada por sitemap.xml, robots.txt, metadataBase
# y la instalación de la PWA. En producción: https://app.caimaneraapp.online
NEXT_PUBLIC_SITE_URL="https://app.caimaneraapp.online"

# Landing project (separate domain). Used for legal links and legacy redirects.
NEXT_PUBLIC_LANDING_URL="https://tudominio.com"

# Tasa de referencia USD → VES usada en el checkout público.
# Si se omite o queda en 0, el total se muestra solo en USD.
NEXT_PUBLIC_VES_RATE="0"

# =============================================================================
# Opcionales — Solo necesarios si usas Dropbox para uploads
# =============================================================================
# DROPBOX_ACCESS_TOKEN=""
# DROPBOX_REFRESH_TOKEN=""
# DROPBOX_APP_KEY=""
# DROPBOX_APP_SECRET=""

# =============================================================================
# SMTP — Configuración de envío de correos (nodemailer)
# =============================================================================
# Sin configurar, los correos se loguean en consola pero no se envían.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="tu-correo@gmail.com"
# SMTP_PASS="tu-contraseña-o-app-password"
# SMTP_FROM_NAME="Caimanera"
# SMTP_FROM_ADDRESS="no-reply@caimanera.app"
