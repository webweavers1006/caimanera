#!/usr/bin/env node
/**
 * prisma/seed — CLI de seeders estilo Laravel.
 *
 * Uso:
 *   node prisma/seed                         → ejecuta seeders pendientes
 *   node prisma/seed --only=auth             → ejecuta solo el seeder 'auth'
 *   node prisma/seed --clean                 → borra BD y ejecuta todo
 *   node prisma/seed --force                 → ignora registro, ejecuta todo
 *   node prisma/seed --list                  → lista seeders ejecutados
 *   node prisma/seed --reset                 → reinicia el registro
 *   node prisma/seed make <nombre>           → crea un nuevo seeder
 *
 * También: npm run seed -- --only=permissions
 */

require('dotenv').config()
const path = require('path')
const { PrismaClient } = require('@prisma/client')
const { Pool } = require('pg')
const { PrismaPg } = require('@prisma/adapter-pg')
const { runSeeders, listSeeded, resetRegistry } = require('./seeds/_runner')

// ── Prisma setup ─────────────────────────────────────────────────────────────

const pool = new Pool({ connectionString: process.env.DATABASE_URL })
const adapter = new PrismaPg(pool)
const prisma = new PrismaClient({ adapter })

// ── Simple logger ────────────────────────────────────────────────────────────

const log = {
  info: (msg) => console.log(msg),
  success: (msg) => console.log(`\x1b[32m${msg}\x1b[0m`),
  error: (msg) => console.error(`\x1b[31m${msg}\x1b[0m`),
  warn: (msg) => console.warn(`\x1b[33m${msg}\x1b[0m`),
}

// ── Parse args ───────────────────────────────────────────────────────────────

const args = process.argv.slice(2)
const flags = { only: null, clean: false, force: false, list: false, reset: false, make: null, markSeeded: false }

for (const arg of args) {
  if (arg === '--clean') flags.clean = true
  else if (arg === '--force') flags.force = true
  else if (arg === '--list') flags.list = true
  else if (arg === '--reset') flags.reset = true
  else if (arg === '--mark-seeded') flags.markSeeded = true
  else if (arg === 'make') flags.make = args[args.indexOf('make') + 1]
  else if (arg.startsWith('--only=')) flags.only = arg.split('=')[1]
}

// ── Help ─────────────────────────────────────────────────────────────────────

if (args.includes('--help') || args.includes('-h')) {
  console.log(`
prisma/seed — Seed runner estilo Laravel

Uso:  node prisma/seed [flags]
      node prisma/seed make <nombre>

Flags:
  --clean          Borra la BD y ejecuta todo (⚠️ solo desarrollo)
  --force          Ignora el registro y re-ejecuta todo
  --only=<nombre>  Ejecuta solo un seeder específico
  --list           Muestra seeders ya ejecutados
  --reset          Reinicia el registro de seeders
  --mark-seeded    Marca todos los seeders como ejecutados SIN correrlos
                   (útil en producción: registra los seeders base sin tocar datos)

Comandos:
  make <nombre>    Crea un nuevo archivo .seed.js en prisma/seeds/

Ejemplos:
  node prisma/seed                          # seeders pendientes
  node prisma/seed --only=permissions       # solo permisos
  node prisma/seed make nuevo-catalogo      # crea template
`)
  process.exit(0)
}

// ── Main ─────────────────────────────────────────────────────────────────────

async function main() {
  // ── make command ────────────────────────────────────────────────────────
  if (flags.make) {
    const rawName = flags.make.replace(/[^a-z0-9_-]/g, '-').toLowerCase()
    const now = new Date()
    const ts = now.getFullYear().toString() +
      String(now.getMonth() + 1).padStart(2, '0') +
      String(now.getDate()).padStart(2, '0') +
      String(now.getHours()).padStart(2, '0') +
      String(now.getMinutes()).padStart(2, '0') +
      String(now.getSeconds()).padStart(2, '0')
    const fileName = `${ts}_${rawName}`
    const filePath = path.join(__dirname, 'seeds', `${fileName}.seed.js`)
    const dataPath = path.join(__dirname, 'seed-data', `${fileName}.json`)
    const fs = require('fs')

    if (fs.existsSync(filePath)) {
      log.error(`❌ El seeder "${fileName}" ya existe.`)
      process.exit(1)
    }

    const template = `/**
 * ${fileName}.seed.js
 *
 * Creado: ${now.toISOString()}
 * Uso:    node prisma/seed --only=${fileName}
 */

exports.name = '${fileName}'

const { helpers } = require('./_runner')
const DATA_FILE = '${fileName}.json'

/** @param {import('@prisma/client').PrismaClient} prisma */
exports.run = async (prisma, log) => {
  const data = helpers.loadData(DATA_FILE)
  log.info('📌 ${rawName}…')

  // TODO: agregar lógica aquí
  // for (const item of data) {
  //   await prisma.xxx.upsert({ ... })
  //   log.success(\`  ✓ \${item.name}\`)
  // }

  log.success(\`  ✓ ${rawName} completado (\${data.length} registros)\`)
}
`

    const dataTemplate = `[
  {
    "_comment": "Agrega tus datos aquí. Se carga con helpers.loadData('${fileName}.json')"
  }
]
`

    fs.mkdirSync(path.dirname(filePath), { recursive: true })
    fs.writeFileSync(filePath, template)
    fs.writeFileSync(dataPath, dataTemplate)
    log.success('✅ Seeder creado:')
    log.info(`   prisma/seeds/${fileName}.seed.js`)
    log.info(`   prisma/seed-data/${fileName}.json`)
    process.exit(0)
  }

  // ── mark-seeded command ─────────────────────────────────────────────────
  if (flags.markSeeded) {
    const all = require('./seeds/_runner').discoverSeeders
      ? require('./seeds/_runner').discoverSeeders(path.join(__dirname, 'seeds'))
      : []
    // Direct discovery inline
    const fs = require('fs')
    const files = fs.readdirSync(path.join(__dirname, 'seeds'))
      .filter(f => f.endsWith('.seed.js'))
      .sort()
    for (const file of files) {
      const mod = require(path.join(__dirname, 'seeds', file))
      if (!mod.name) continue
      const already = await prisma.seeder.findUnique({ where: { name: mod.name } })
      if (already) {
        log.info(`  ⏭️  ${mod.name}: ya registrado`)
      } else {
        await prisma.seeder.create({ data: { name: mod.name } })
        log.success(`  ✓ ${mod.name}: marcado como ejecutado`)
      }
    }
    log.success('\n✅ Seeders base registrados sin ejecutar.')
    process.exit(0)
  }

  // ── list command ────────────────────────────────────────────────────────
  if (flags.list) {
    const rows = await listSeeded(prisma)
    if (rows.length === 0) {
      log.info('📋 No hay seeders ejecutados.')
    } else {
      log.info('📋 Seeders ejecutados:')
      for (const r of rows) {
        log.info(`   ${r.name} — ${r.executedAt.toISOString()}`)
      }
    }
    process.exit(0)
  }

  // ── reset command ───────────────────────────────────────────────────────
  if (flags.reset) {
    await resetRegistry(prisma)
    log.success('✅ Registro de seeders reiniciado.')
    process.exit(0)
  }

  // ── clean mode ──────────────────────────────────────────────────────────
  const mode = flags.clean ? 'clean' : 'supplement'

  if (flags.clean) {
    log.warn('\n⚠️  MODO CLEAN: borrando toda la base de datos…\n')

    // FK-safe truncate via raw SQL (CASCADE would be simpler but this is explicit)
    const tables = [
      'auditoria', 'notificaciones', 'registros_cgr',
      'participantes_caso', 'mediaciones', 'seguimientos_caso',
      'documentos_caso', 'remisiones_caso', 'denuncias_caso', 'coordenadas_caso',
      'turnos', 'correos_enviados', 'casos', 'contador_casos',
      'personas',
      'usuarios',
      'roles_permisos', 'direcciones_areas',
      'permisos', 'roles',
      'paises', 'estatus_caso', 'estatus_llamada', 'canales_atencion',
      'entes_adscritos', 'org_poder_popular', 'tipos_beneficiario',
      'areas_caso', 'motivos', 'tipos_atencion', 'detalles_tipo_atencion',
      'direcciones_administrativas', 'oficinas', 'tramites',
      'parroquias', 'municipios', 'estados',
      '_seeders',
    ]

    for (const t of tables) {
      await prisma.$executeRawUnsafe(`DELETE FROM "${t}"`)
    }
    log.success('  ✓ Base de datos limpiada\n')
  }

  // ── Run ─────────────────────────────────────────────────────────────────
  await runSeeders({
    prisma,
    log,
    mode,
    only: flags.only,
    force: flags.force,
  })

  log.info('\n✨ Listo.')
}

main()
  .catch((e) => { log.error(`❌ ${e.message}`); process.exit(1) })
  .finally(() => prisma.$disconnect())
